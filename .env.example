# ------------------------------------------------------------------
# ShopFusion - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your real `.env` file to version control.
# ------------------------------------------------------------------

# MongoDB connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Secret used to sign session JWT tokens (use a long random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-secret

# Stripe - https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY is accepted as a legacy alias.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Stripe events to register on the webhook endpoint (POST /api/webhooks):
#   checkout.session.completed, checkout.session.expired, payment_intent.cancelled

# Cloudinary - https://cloudinary.com/console
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-api-key
CLOUD_API_SECRET=your-api-secret

# Public base URL used for absolute links (Stripe redirects, ISR revalidation)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Initial admin account (email/password used to seed the first admin user)
ADMIN_EMAIL=admin@shopfusion.com
ADMIN_PASSWORD=admin123
